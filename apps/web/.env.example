# Demo mode is the default: fixtures + a ticking odds simulator, zero network.
NEXT_PUBLIC_DEMO=1

# Chain mode: unset NEXT_PUBLIC_DEMO (or set it to 0) and name the deployment cluster. Both
# packages/sdk/deployments/{localnet,devnet}.json are bundled; scripts/bootstrap writes them.
# Localnet (see "Chain mode from a cold start" in README.md):
# NEXT_PUBLIC_DEPLOYMENT=localnet
# NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8999
# Devnet:
# NEXT_PUBLIC_DEPLOYMENT=devnet
# NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com

# Server only: operator keypair (mint authority) for /api/faucet on localnet/devnet.
# Relative paths resolve from apps/web; the bootstrap generates this file on localnet.
# FAUCET_KEYPAIR_PATH=../../scripts/.keys/id.json
