# RPC endpoint. localnet: http://127.0.0.1:8899   devnet: https://api.devnet.solana.com
RPC_URL=http://127.0.0.1:8899

# Operator keypair (JSON byte array, `solana-keygen new -o .keys/id.json`).
# Relative paths resolve against the scripts/ directory. On localnet a missing file is created.
# To reuse the WSL deploy key: KEYPAIR_PATH=\\wsl$\Ubuntu\home\<user>\.config\solana\id.json
KEYPAIR_PATH=./.keys/id.json

# Optional: override the cluster detected from RPC_URL (localnet | devnet | mainnet).
# CLUSTER=devnet

# Optional: override the program id from packages/sdk/idl/duel.json.
# PROGRAM_ID=AN2TEyFH3zCsv5MENn2uo9LJx69J2EUC8iScAVeDbW25

# Pyth Hermes needs an API key since the Pyth Core upgrade (Aug 2026). Free trial: Pyth Terminal.
# Only needed by `resolve` without --manual and by mainnet odds; devnet reads pair prices from pools.
# PYTH_API_KEY=
# HERMES_URL=https://pyth.dourolabs.app/hermes
